name: Aggiorna marea

on:
  schedule:
    - cron: "*/10 * * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  scarica:
    runs-on: ubuntu-latest
    steps:
      - name: Prendi il sito
        uses: actions/checkout@v4

      - name: Scarica i livelli del Comune
        run: |
          mkdir -p dati
          curl -fsSL --max-time 30 -A "Mozilla/5.0 (X11; Linux x86_64)" "https://dati.venezia.it/sites/default/files/dataset/opendata/livello.json" -o dati/nuovo.json
          python3 -c "import json; d=json.load(open('dati/nuovo.json')); assert isinstance(d, list) and len(d) > 0"
          mv dati/nuovo.json dati/livello.json

      - name: Salva se è cambiato
        run: |
          git config user.name "marea-bot"
          git config user.email "marea-bot@users.noreply.github.com"
          git add dati/livello.json
          git diff --cached --quiet || (git commit -m "Aggiorna marea" && git push)
